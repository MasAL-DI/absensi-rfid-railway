# Environment Variables — Copy ke Railway Project Settings
# Dokumentasi: https://docs.railway.app/develop/variables

# ===== MySQL Configuration =====
# Dari Railway MySQL plugin
MYSQLHOST=your-mysql-host.railway.internal
MYSQLUSER=root
MYSQLPASSWORD=your-secure-password
MYSQLDATABASE=db_absensi
MYSQLPORT=3306

# ===== JWT Secret =====
# Generate random string minimal 32 karakter
# Linux/Mac: openssl rand -base64 32
# Jangan gunakan string yang mudah ditebak!
JWT_SECRET=your_random_32_char_secret_key_here_must_be_strong_and_unique

# ===== Application Settings =====
APP_ENV=production
APP_DEBUG=false
APP_URL=https://absensi-api.railway.app

# ===== CORS Origins (opsional, untuk update di config.php nanti) =====
# Format: comma-separated
CORS_ORIGINS=https://absensi-rfid-railway.vercel.app,http://localhost:3000
